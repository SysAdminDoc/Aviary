{
  "manifest_version": 3,
  "name": "Aviary for X",
  "description": "Local-first X/Twitter enhancer with reversible controls and privacy-first defaults.",
  "version": "1.12.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "aviary@example.local",
      "strict_min_version": "128.0"
    }
  },
  "action": {
    "default_title": "Aviary"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage"
  ],
  "optional_permissions": [
    "downloads"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://mobile.twitter.com/*",
    "https://pro.x.com/*",
    "https://tweetdeck.twitter.com/*"
  ],
  "optional_host_permissions": [
    "https://pbs.twimg.com/*",
    "https://video.twimg.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://mobile.twitter.com/*",
        "https://pro.x.com/*",
        "https://tweetdeck.twitter.com/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://mobile.twitter.com/*",
        "https://pro.x.com/*",
        "https://tweetdeck.twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
