{
  "name": "aviary-x-enhancer",
  "version": "1.19.0",
  "private": true,
  "type": "module",
  "description": "Local-first X/Twitter enhancer delivered as a readable userscript and MV3 extension.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "capture:settings": "node tools/capture-settings.mjs",
    "capture:theme": "node tools/capture-theme.mjs",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.mjs\" \"tools/**/*.mjs\" \"eslint.config.mjs\"",
    "preflight": "node tools/preflight.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:matrix": "node --test tests/release-matrix.test.mjs",
    "typecheck": "tsc --noEmit",
    "smoke": "node tests/smoke/aviary.smoke.mjs && node tests/smoke/externally-gated.smoke.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run preflight"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "esbuild": "0.25.5",
    "eslint": "9.27.0",
    "globals": "17.11.0",
    "playwright": "1.62.1",
    "typescript": "5.9.3"
  }
}
