{
  "name": "aviary-x-enhancer",
  "version": "1.33.0",
  "private": true,
  "type": "module",
  "description": "Local-first X/Twitter enhancer delivered as a readable userscript and MV3 extension.",
  "license": "MIT",
  "author": "SysAdminDoc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SysAdminDoc/Aviary.git"
  },
  "homepage": "https://github.com/SysAdminDoc/Aviary",
  "engines": {
    "node": "^22.23.2 || ^24.18.1 || >=26.5.1"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "capture:decode": "node tools/capture-decode.mjs",
    "capture:settings": "node tools/capture-settings.mjs",
    "capture:theme": "node tools/capture-theme.mjs",
    "docs:settings": "node tools/settings-reference.mjs",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.mjs\" \"tools/**/*.mjs\" \"eslint.config.mjs\"",
    "preflight": "node tools/preflight.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:matrix": "node --test tests/release-matrix.test.mjs",
    "test:visual": "npm run build && node --test tests/visual/settings-visual-regression.test.mjs",
    "test:visual:update": "npm run build && node tools/update-settings-visuals.mjs",
    "typecheck": "tsc --noEmit",
    "smoke": "node tests/smoke/dnr-chromium.smoke.mjs && node tests/smoke/dnr-firefox.smoke.mjs && node tests/smoke/aviary.smoke.mjs && node tests/smoke/externally-gated.smoke.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run preflight"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "playwright": "1.62.1",
    "typescript": "6.0.3"
  }
}
